# Both values are optional. Without them the whole app still works offline:
# duel, susun cepat, leaderboard, and the teacher panel all fall back to
# localStorage. Only room-code duels and the shared online leaderboard need
# Supabase. Never put a service-role key in this file: the browser bundle would
# ship it to every visitor.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
